{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && prettier --check \"src/**/*.{ts,tsx,css,scss,json,md}\"",
    "typecheck": "tsc -b",
