    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "topojson-client": "^3.1.0",
    "vite-plugin-cesium": "^1.2.23",
    "world-atlas": "^2.0.2"
